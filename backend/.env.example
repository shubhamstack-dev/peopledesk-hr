# MySQL connection (database and user created by database/schema.sql + the GRANT in README)
DATABASE_URL=mysql+pymysql://peopledesk:change-me@127.0.0.1:3306/peopledesk?charset=utf8mb4

# Long random string; keeps sessions valid across restarts. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Hours a sign-in lasts (the app also signs out after the idle time set in Settings)
SESSION_HOURS=12

# true when served over https
COOKIE_SECURE=false

# Only needed if the React app is served from a different origin than the API (not needed with the Vite proxy)
CORS_ORIGINS=
