# Docker settings (copy to .env next to docker-compose.yml)
# Passwords: any characters except $ (Docker treats $ as a variable).
MYSQL_USER=peopledesk
MYSQL_PASSWORD=change-me-letters-and-numbers
MYSQL_ROOT_PASSWORD=change-me-too
JWT_SECRET=
SESSION_HOURS=12
APP_TZ=Asia/Kolkata
APP_PORT=8080
# On the server: APP_PORT=127.0.0.1:8087 (reachable only through Caddy)
COOKIE_SECURE=false
# On the server: COOKIE_SECURE=true
CORS_ORIGINS=

# E-mail to HR when an employee asks to change statutory details (optional)
# Microsoft 365: smtp.office365.com, port 587, starttls, a mailbox allowed to send with SMTP AUTH
# Google Workspace: smtp.gmail.com, port 587, starttls, an app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls
# Address of PeopleDesk, used for links in e-mails
APP_URL=https://peopledeskhr.example.com
