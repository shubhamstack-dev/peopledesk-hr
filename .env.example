# Docker settings (copy to .env next to docker-compose.yml)
# Passwords: any characters except $ (Docker treats $ as a variable).
MYSQL_USER=peopledesk
MYSQL_PASSWORD=change-me-letters-and-numbers
MYSQL_ROOT_PASSWORD=change-me-too
JWT_SECRET=
SESSION_HOURS=12
APP_TZ=Asia/Kolkata
APP_PORT=8080
# On the server: APP_PORT=127.0.0.1:8087 (reachable only through Caddy)
COOKIE_SECURE=false
# On the server: COOKIE_SECURE=true
CORS_ORIGINS=
